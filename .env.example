# Copiar a .env.local y completar
# Opcional: sólo si hay dominio propio (por defecto https://franco-spatocco.vercel.app)
NEXT_PUBLIC_SITE_URL=
# Opcional: otro form de Formspree (por defecto el del portfolio)
NEXT_PUBLIC_FORMSPREE_ID=

# Asistente "Preguntale al portfolio" (/api/ask). Sin clave o sin Redis en
# producción el campo libre se apaga y quedan las preguntas sugeridas.
# Clave de la API de Claude (sólo servidor, nunca NEXT_PUBLIC_)
ANTHROPIC_API_KEY=
# Sólo si la clave no está asociada a un workspace
ANTHROPIC_WORKSPACE_ID=
# Opcional: modelo (por defecto claude-haiku-5-5)
AI_MODEL=
# Opcionales: topes diarios (por visitante: 8, global: 150)
AI_IP_DAILY_LIMIT=
AI_GLOBAL_DAILY_CAP=
# Contadores de los topes: Upstash Redis desde el Marketplace de Vercel
# (acepta también KV_REST_API_URL / KV_REST_API_TOKEN). En desarrollo se usa memoria.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
